<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Reflecta.ViewModels"
             xmlns:controls="clr-namespace:Reflecta.Views.Controls"
             x:Class="Reflecta.Views.OnboardingPage"
             x:DataType="vm:OnboardingViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="32,60,32,40" Spacing="32" VerticalOptions="Center">

            <!-- App icon / glow -->
            <Border HorizontalOptions="Center"
                    WidthRequest="110" HeightRequest="110"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#A855F7" Offset="0" />
                        <GradientStop Color="#7C3AED" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Label Text="✦" FontSize="56" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- Heading -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label Text="Welcome to Reflecta"
                       Style="{StaticResource HeadingLabel}"
                       HorizontalOptions="Center" />
                <Label Text="Your personal AI companion for journaling,&#10;reflection, and emotional growth."
                       Style="{StaticResource MutedLabel}"
                       FontSize="15"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Feature rows -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="20">
                    <!-- Feature 1 -->
                    <HorizontalStackLayout Spacing="16">
                        <Border WidthRequest="44" HeightRequest="44"
                                BackgroundColor="{StaticResource ChipBackground}"
                                StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Label Text="💬" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Chat with AI" Style="{StaticResource SubheadingLabel}" FontSize="15" />
                            <Label Text="Reflect, vent, and get empathetic guidance"
                                   Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Separator -->
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource SurfaceBorder}" />

                    <!-- Feature 2 -->
                    <HorizontalStackLayout Spacing="16">
                        <Border WidthRequest="44" HeightRequest="44"
                                BackgroundColor="{StaticResource ChipBackground}"
                                StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Label Text="📔" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Journal Entries" Style="{StaticResource SubheadingLabel}" FontSize="15" />
                            <Label Text="Text, mood, task, and voice formats"
                                   Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Separator -->
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource SurfaceBorder}" />

                    <!-- Feature 3 -->
                    <HorizontalStackLayout Spacing="16">
                        <Border WidthRequest="44" HeightRequest="44"
                                BackgroundColor="{StaticResource ChipBackground}"
                                StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Label Text="📊" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Track Progress" Style="{StaticResource SubheadingLabel}" FontSize="15" />
                            <Label Text="Mood trends, weekly insights, key themes"
                                   Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- CTA Button -->
            <controls:PrimaryButton Text="Get Started ✦"
                                    Command="{Binding GetStartedCommand}"
                                    Margin="0,8" />

            <!-- Footer -->
            <Label Text="🔒 Your thoughts are private and secure."
                   Style="{StaticResource MutedLabel}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
