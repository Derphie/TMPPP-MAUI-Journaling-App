<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Reflecta.ViewModels"
             xmlns:controls="clr-namespace:Reflecta.Views.Controls"
             xmlns:models="clr-namespace:Reflecta.Models"
             x:Class="Reflecta.Views.JournalPage"
             x:DataType="vm:JournalViewModel"
             Title="Journal"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ── Header ── -->
        <Grid Grid.Row="0" Padding="16,16,16,8" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" Text="Journal"
                   Style="{StaticResource HeadingLabel}" VerticalOptions="Center"/>
            <Border Grid.Column="1" WidthRequest="44" HeightRequest="44" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#A855F7" Offset="0"/>
                        <GradientStop Color="#7C3AED" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenNewEntryCommand}" />
                </Border.GestureRecognizers>
                <Label Text="+" FontSize="26" FontAttributes="Bold" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

        <!-- ── Search ── -->
        <Border Grid.Row="1" Margin="16,0,16,8"
                BackgroundColor="{StaticResource SurfaceContainer}"
                StrokeThickness="1" Stroke="{StaticResource OutlineVariant}"
                Padding="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
            <SearchBar Placeholder="Search entries..."
                       Text="{Binding SearchQuery}"
                       BackgroundColor="Transparent" />
        </Border>

        <!-- ── Entry list ── -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Entries}"
                        Margin="16,0" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:JournalEntry">
                    <!-- M3 card: surfaceContainer background, outlineVariant border, 16dp radius -->
                    <Border BackgroundColor="{StaticResource SurfaceContainer}"
                            StrokeThickness="1" Stroke="{StaticResource OutlineVariant}"
                            Padding="16" Margin="0,0,0,10">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenEntryCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="10">
                            <!-- Mood emoji + title + state badges + ⋮ menu -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Text="{Binding MoodEmoji}" FontSize="24"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding DisplayTitle}"
                                       Style="{StaticResource SubheadingLabel}"
                                       FontSize="15" VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                    <Label Text="📌" FontSize="14" IsVisible="{Binding IsPinned}" />
                                    <Label Text="⭐" FontSize="14" IsVisible="{Binding IsFavorite}" />
                                    <Label Text="🔒" FontSize="14" IsVisible="{Binding IsEncrypted}" />
                                    <!-- M3 overflow menu trigger -->
                                    <Label Text="⋮" FontSize="20"
                                           TextColor="{StaticResource SecondaryText}"
                                           VerticalOptions="Center"
                                           Padding="4,0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ShowEntryMenuCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>
                            </Grid>

                            <!-- Date + body preview -->
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding CreatedAt, StringFormat='{0:ddd, MMM d · HH:mm}'}"
                                       Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding Body}"
                                       Style="{StaticResource MutedLabel}"
                                       FontSize="13" MaxLines="2"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <!-- Tags — fully-rounded M3 chips -->
                            <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start"
                                        BindableLayout.ItemsSource="{Binding TagList}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <controls:TagChip Text="{Binding .}" Margin="0,0,6,4" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                     Spacing="14" Margin="0,60">
                    <Label Text="📔" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="No entries yet"
                           Style="{StaticResource SubheadingLabel}"
                           HorizontalOptions="Center"/>
                    <Label Text="Tap + to write your first entry"
                           Style="{StaticResource MutedLabel}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- ── Editor overlay — M3 bottom-sheet style (28dp top corners) ── -->
        <Grid Grid.RowSpan="3" BackgroundColor="#CC000000"
              IsVisible="{Binding ShowEditor}">
            <Border Margin="0,60,0,0"
                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                    StrokeThickness="1" Stroke="{StaticResource OutlineVariant}"
                    Padding="20" VerticalOptions="End">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28,28,0,0"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <!-- Drag handle pill -->
                    <BoxView WidthRequest="32" HeightRequest="4"
                             BackgroundColor="{StaticResource SecondaryText}"
                             CornerRadius="2"
                             HorizontalOptions="Center" Margin="0,0,0,4" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="{Binding EditorTitle}"
                               Style="{StaticResource SubheadingLabel}" />
                        <Label Grid.Column="1" Text="✕" FontSize="20"
                               TextColor="{StaticResource SecondaryText}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DismissEditorCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <Picker Title="Entry type"
                            SelectedIndex="{Binding NewTypeIndex}"
                            TextColor="{StaticResource PrimaryText}"
                            BackgroundColor="Transparent">
                        <Picker.Items>
                            <x:String>📝 Text</x:String>
                            <x:String>😊 Mood</x:String>
                            <x:String>✅ Task</x:String>
                            <x:String>🎙️ Voice</x:String>
                        </Picker.Items>
                    </Picker>

                    <Border BackgroundColor="{StaticResource InputBackground}"
                            StrokeThickness="1" Stroke="{StaticResource OutlineVariant}"
                            Padding="12,8">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <Entry Placeholder="Title..." Text="{Binding NewTitle}" />
                    </Border>

                    <Border BackgroundColor="{StaticResource InputBackground}"
                            StrokeThickness="1" Stroke="{StaticResource OutlineVariant}"
                            Padding="12,8">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <Editor Placeholder="Write your thoughts..."
                                Text="{Binding NewBody}"
                                MinimumHeightRequest="100"
                                AutoSize="TextChanges" />
                    </Border>

                    <Border BackgroundColor="{StaticResource InputBackground}"
                            StrokeThickness="1" Stroke="{StaticResource OutlineVariant}"
                            Padding="12,8">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <Entry Placeholder="Tags (e.g. stress, school, gratitude)"
                               Text="{Binding NewTags}" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <!-- M3 tonal button for secondary action -->
                        <Button Grid.Column="0" Text="Cancel"
                                BackgroundColor="{StaticResource UserBubble}"
                                TextColor="{StaticResource SecondaryText}"
                                CornerRadius="20"
                                Command="{Binding DismissEditorCommand}" />
                        <controls:PrimaryButton Grid.Column="1"
                                               Text="Save Entry"
                                               Command="{Binding SaveEntryCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
