<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ── Background ── -->
    <Color x:Key="AppBackground">#0A0A0F</Color>
    <Color x:Key="SurfaceColor">#1A1825</Color>
    <Color x:Key="SurfaceBorder">#29FFFFFF</Color>

    <!-- ── Accent / Primary ── -->
    <Color x:Key="PrimaryStart">#A855F7</Color>
    <Color x:Key="PrimaryEnd">#7C3AED</Color>
    <Color x:Key="PrimaryText">#F5F5F7</Color>
    <Color x:Key="SecondaryText">#8B8B9A</Color>

    <!-- ── Chips ── -->
    <Color x:Key="ChipBackground">#33A855F7</Color>
    <Color x:Key="ChipText">#C4A8F7</Color>

    <!-- ── Semantic ── -->
    <Color x:Key="ErrorColor">#FF453A</Color>
    <Color x:Key="SuccessColor">#30D158</Color>
    <Color x:Key="UserBubble">#2A2838</Color>
    <Color x:Key="AiBubble">#1F1A2E</Color>
    <Color x:Key="InputBackground">#141220</Color>

    <!-- ── Tab bar ── -->
    <Color x:Key="TabInactive">#4A4A5A</Color>
    <Color x:Key="TabActive">#A855F7</Color>

</ResourceDictionary>
